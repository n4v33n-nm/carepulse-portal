# =============================================================================
# CarePulse Portal - Comprehensive Git Ignore Policy
# =============================================================================

# Environment & Sensitive Secret Configurations
.env
.env.*
!.env.example
application-local.properties
application-prod.properties
**/application-local.properties
**/application-prod.properties

# Java & Maven Build Artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# Node.js & Vite Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
package-lock.json.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Code Editor Files
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.vscode/
**/.vscode/
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Operating System Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Runtime Diagnostics
*.log
logs/
**/logs/
*.tmp
*.temp
*.swp
*~

# Temporary Test / Verification Scratch Scripts
**/verify_*.cjs
**/debug_*.cjs
