# =============================================================================
# CarePulse Portal - Environment Variables Template
# Copy this file to .env and configure your local or production settings.
# NEVER commit real passwords, tokens, or private keys to version control.
# =============================================================================

# Server Ports
PORT=8080
FRONTEND_PORT=5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carepulse
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carepulse
SPRING_DATASOURCE_USERNAME=your_postgres_username
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Security
JWT_SECRET=your_secure_256bit_hex_secret_key_here
JWT_EXPIRATION_MS=86400000

# Optional External AI API Key (OpenAI / Google Gemini)
AI_API_KEY=your_ai_api_key_here
